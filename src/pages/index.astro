---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PubItem from '../components/PubItem.astro';
import Timeline from '../components/Timeline.astro';
import profile from '../assets/profile.png';
import { site, interests, experience, education, patents, service } from '../data/site';
import { publications, myNames } from '../data/publications';

const tagColors = [
  'bg-highlight/70 border-highlight',
  'bg-amber/25 border-amber/50',
  'bg-sage/25 border-sage/50',
  'bg-moss/20 border-moss/40',
];
const selected = publications.filter((p) => p.selected);
const socials = [
  { href: `mailto:${site.email}`, label: 'Email', icon: 'mdi:email-outline' },
  { href: site.cv, label: 'CV', icon: 'mdi:file-document-outline' },
  { href: site.links.scholar, label: 'Scholar', icon: 'academicons:google-scholar' },
  { href: site.links.github, label: 'GitHub', icon: 'mdi:github' },
  { href: site.links.linkedin, label: 'LinkedIn', icon: 'mdi:linkedin' },
];
---

<Base>
  <section
    class="hero-glow border-line bg-surface/60 -mx-4 flex flex-col-reverse gap-8 border-y px-4 py-8 sm:mx-0 sm:flex-row sm:items-start sm:justify-between sm:rounded-2xl sm:border sm:p-8"
  >
    <div class="space-y-4">
      <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{site.name}</h1>
      <p class="text-muted text-lg">{site.role}</p>
      <ul class="flex flex-wrap gap-2 pt-1">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener"
                class="border-line bg-surface text-accent hover:bg-accent hover:text-bg hover:border-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors"
              >
                <Icon name={s.icon} class="size-4" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <Image
      src={profile}
      alt={`Portrait of ${site.name}`}
      width={320}
      height={320}
      loading="eager"
      class="ring-accent size-36 shrink-0 rounded-full object-cover ring-4 sm:size-40"
    />
  </section>

  <section class="mt-12 space-y-4 text-[1.05rem] leading-relaxed">
    <p>
      I'm an AI engineer and computer vision researcher. I received my PhD in Computer Science from{' '}
      <a class="link" href="https://www.yorku.ca/" target="_blank" rel="noopener">York University</a> in 2024, advised by{' '}
      <a class="link" href="http://www.cse.yorku.ca/~mbrown/" target="_blank" rel="noopener">Prof. Michael S. Brown</a>{' '}
      in the Computational Vision and Imaging Lab. Before that, I earned an MSc from POSTECH in South Korea.
    </p>
    <p>
      My doctoral research focused on color science for camera imaging: recovering the wide-gamut colors that are lost
      when photos are converted from ProPhoto RGB to sRGB. I developed three approaches (a deep network, metadata-based
      color subsampling, and a lightweight MLP), released large-scale datasets, and published at CVPR and CIC. The
      GamutMLP work with Adobe led to a granted US patent. During my PhD I also interned at Samsung AI Center Toronto,
      on deep-learning white balance for smartphone cameras, and at Borealis AI, on deep survival analysis.
    </p>
    <p>
      Today I'm an AI Engineer at Sunvair, building LLM-agent platforms that connect language models to enterprise
      data and tools. I continue to collaborate on research in vision-language models and video retrieval.
    </p>
    <ul class="flex flex-wrap gap-2 pt-2">
      {
        interests.map((label, i) => (
          <li class:list={['text-ink rounded-full border px-3 py-1 text-sm font-medium', tagColors[i % tagColors.length]]}>
            {label}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 space-y-8">
    <h2 class="section-title">Selected publications</h2>
    <div class="space-y-8">
      {selected.map((pub) => <PubItem pub={pub} />)}
    </div>
    <a href="/publications/" class="link inline-flex items-center gap-1 text-sm">
      All publications <Icon name="mdi:arrow-right" class="size-4" />
    </a>
  </section>

  <section class="mt-16 space-y-6">
    <h2 class="section-title">Patents</h2>
    <ul class="space-y-5">
      {
        patents.map((p) => (
          <li class="space-y-1">
            <h3 class="font-serif text-lg leading-snug font-semibold">{p.title}</h3>
            <p class="text-muted text-sm">
              {p.authors.map((a, i) => (
                <>
                  {myNames.includes(a) ? <strong class="text-ink font-semibold">{a}</strong> : a}
                  {i < p.authors.length - 1 && ', '}
                </>
              ))}
            </p>
            <p class="text-sm italic">
              {p.status} · {p.assignee}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 grid gap-12 md:grid-cols-2">
    <div class="space-y-6">
      <h2 class="section-title">Experience</h2>
      <Timeline items={experience} dot="bg-amber" />
    </div>
    <div class="space-y-12">
      <div class="space-y-6">
        <h2 class="section-title">Education</h2>
        <Timeline items={education} dot="bg-moss" />
      </div>
      <div class="space-y-4">
        <h2 class="section-title">Service</h2>
        <p class="text-sm leading-relaxed">
          <span class="font-semibold">Reviewer</span>
          <span class="text-muted"> · {service.join(', ')}</span>
        </p>
      </div>
    </div>
  </section>
</Base>
